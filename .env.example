# Copy to .env and fill in. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Live voice model (speech-to-speech). Check the current ID in AI Studio.
GEMINI_LIVE_MODEL=gemini-3.8-live
# API version used for ephemeral tokens + Live connection
GEMINI_LIVE_API_VERSION=v1alpha
# Tutor voice (prebuilt Gemini voice)
GEMINI_VOICE=Aoede

# Carla's reading voice (podcast, ▶ buttons): generated once per text, then cached
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Image model for « Décrire l'image » (generated once per scene, then cached)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Text model for the end-of-session debrief
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Passcode she types to log in (pick something easy for her, hard to guess)
APP_PASSCODE=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Learner settings
LEARNER_LEVEL=A1
SESSION_MINUTES=15

# Public hostname served by Caddy (HTTPS is required for the microphone)
APP_HOST=hablemos.62-171-172-248.sslip.io

# Key for automations (n8n) reading /api/n8n/summary. Generate with: openssl rand -hex 24
N8N_API_KEY=

# Set to 1 to enable the /debug page (Gemini Live diagnostics)
ENABLE_DEBUG=0
# Extra areas (Entretiens, Vie réelle, podcast, telenovela…). 0 = core loop only.
FEATURES_LAB=0

# Monthly Gemini budget shown on the Profile page (EUR)
MONTHLY_BUDGET_EUR=15
# Estimated prices, USD per 1M tokens (check Google's price list; used only for the estimate)
# PRICE_LIVE_TEXT_IN=0.5
# PRICE_LIVE_AUDIO_IN=3
# PRICE_LIVE_TEXT_OUT=2
# PRICE_LIVE_AUDIO_OUT=12
# PRICE_TEXT_IN=0.3
# PRICE_TEXT_AUDIO_IN=1
# PRICE_TEXT_OUT=2.5
# PRICE_TTS_IN=0.5
# PRICE_TTS_OUT=10
# PRICE_IMAGE_OUT=30
# EUR_PER_USD=0.92

# Copy to .env and fill in. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Live voice model (speech-to-speech). Check the current ID in AI Studio.
GEMINI_LIVE_MODEL=gemini-3.8-live
# API version used for ephemeral tokens + Live connection
GEMINI_LIVE_API_VERSION=v1alpha
# Tutor voice (prebuilt Gemini voice)
GEMINI_VOICE=Aoede

# Text model for the end-of-session debrief
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Passcode she types to log in (pick something easy for her, hard to guess)
APP_PASSCODE=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Learner settings
LEARNER_LEVEL=A1
SESSION_MINUTES=15

# Public hostname served by Caddy (HTTPS is required for the microphone)
APP_HOST=hablemos.62-171-172-248.sslip.io
